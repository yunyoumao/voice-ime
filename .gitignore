# 虚拟环境
.venv/
venv/

# 用户私有配置（含 API key，绝不入库）
config.yaml

# 本地模型（体积大，按需下载）
models/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# 系统/日志
.DS_Store
*.log

# 编辑备份（hook 自动生成）
*.bak

# 会话工作状态（handoff 等，本地用，不入库）
.claude/

# 视觉预览图（离屏渲染用于肉眼验证，本地用，不入库）
_preview_*.png
_preview_tmp/

# PyInstaller 打包产物（体积大，发布走 GitHub Releases，不入库）
dist/
build/
*.manifest
